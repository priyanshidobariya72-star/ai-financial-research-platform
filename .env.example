# Copy this file to .env and update the values for your PostgreSQL database.

# API Configuration
API_TITLE=AI Financial Research Platform API
API_VERSION=0.1.0
DEBUG=False

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/ai_financial_research_platform
TEST_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/ai_financial_research_platform_test
DATABASE_ECHO=False

# Server Configuration
HOST=127.0.0.1
PORT=8000
RELOAD=False
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Feature Flags
ENABLE_DOCS=True
ENABLE_REDOC=True

# External APIs
GNEWS_API_KEY=

# ETL Configuration
ETL_SYMBOLS=AAPL,META,MSFT
ETL_DRY_RUN=false

# Document RAG Configuration
RAG_DOCUMENTS_DIR=data/documents
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION_NAME=financial_documents
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
