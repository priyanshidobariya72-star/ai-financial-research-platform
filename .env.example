# Copy this file to .env and update the values for your PostgreSQL database.

# API Configuration
API_TITLE=AI Financial Research Platform API
API_VERSION=0.1.0
DEBUG=False

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/ai_financial_research_platform
DATABASE_ECHO=False

# Server Configuration
HOST=127.0.0.1
PORT=8000
RELOAD=False

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Feature Flags
ENABLE_DOCS=True
ENABLE_REDOC=True
